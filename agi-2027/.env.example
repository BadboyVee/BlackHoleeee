# Copy to .env.local for local development. Never commit real values.

# Supabase: Project Settings → API Keys (use the dev project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SECRET_KEY=

# Public site URL, used for links in emails and link previews.
# On Vercel and Netlify this is worked out automatically when left empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown in the site footer once set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_URL=

# Email through Resend (resend.com > API Keys). Without it, leads still save and the outbox records why no email went out.
RESEND_API_KEY=
# Sender for every email. Resend's test sender works until your domain is verified in Resend > Domains.
EMAIL_FROM="AGI 2027 <onboarding@resend.dev>"
# The owner's inbox for new Book a campaign leads. With the test sender, use your Resend account's email.
LEADS_NOTIFY_EMAIL=
# Protects POST /api/outbox, which sends queued emails. Any long random string, e.g. openssl rand -hex 32.
CRON_SECRET=
# Salts the hashed IP used to rate limit public forms. Any long random string, e.g. openssl rand -hex 32.
RATE_LIMIT_SALT=

# Database tests: a Postgres server the tests can create throwaway databases on.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
