# render byproducts: the soundtrack WAVs, audio level caches and near-lossless masters are rebuilt by main.py
out/*.wav
out/*.npz
out/*.mkv
out/.segs/
__pycache__/
out/player_frames/
photos/*
!photos/README.md
# the Arnaud's spot is built from photographs supplied for it, so its render stays local like the photos
out/arnauds.mp4
out/arnauds_intro.mp4
# AGI WEEK uses the founders' photographs supplied for it, so its render stays local too
out/agiweek.mp4
out/agiweek_preview.mp4
# DEVDAY 2026 carries the teaser's own soundtrack, supplied for it, so its render stays local too
out/devday.mp4
# VEEE carries the reference spot's own soundtrack, supplied for it, so its render stays local too
out/veee.mp4
# HORIZON and the CLAUDE CODE spot carry their reference spots' own soundtracks, so their renders stay local too;
# their Blender plates and sprites are rebuilt by blender/hills.py and blender/plush.py
out/horizon.mp4
out/claude-code.mp4
out/plates/
